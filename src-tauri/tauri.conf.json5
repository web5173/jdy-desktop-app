{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jdy",
  "version": "0.1.0",
  "identifier": "web5173.12219063BD17",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splashscreen",
        "url": "/splashscreen.html",
        "center": true,
        "alwaysOnTop": true,
        "shadow": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "resizable": false,
        "width": 128,
        "height": 128,
        title: "简道云",
        skipTaskbar: true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}